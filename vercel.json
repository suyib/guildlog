{
  "functions": {
    "api/*.ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/discord", "schedule": "0 17 * * *" }],
  "rewrites": [
    { "source": "/a/:id", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" }
  ]
}
